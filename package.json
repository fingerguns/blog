{
  "name": "blog",
  "private": true,
  "description": "Static minimalist blog with Atom feed; optional Node build for index + feed",
  "scripts": {
    "build": "node --env-file=.env scripts/build.mjs",
    "backfill-video-posters": "node --env-file=.env scripts/backfill-video-posters.mjs",
    "refresh-section-hints": "node --env-file=.env scripts/refresh-section-hints.mjs",
    "refresh-reading-tab-intros": "node --env-file=.env scripts/refresh-reading-tab-intros.mjs",
    "backfill-reading-genres": "node --env-file=.env scripts/backfill-reading-genres.mjs",
    "backfill-linklog-tags": "node --env-file=.env scripts/backfill-linklog-tags.mjs",
    "backfill-thinking-locations": "node --env-file=.env scripts/backfill-thinking-locations.mjs",
    "backfill-oura": "node --env-file=.env scripts/backfill-oura.mjs",
    "anthropic-usage": "node --env-file=.env scripts/anthropic-usage.mjs",
    "preview": "npx serve dist -p 3000",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "markdownlint-cli2": "^0.23.2"
  }
}
