{
  "manifest_version": 3,
  "name": "Share to rommy.blog",
  "version": "1.0.0",
  "description": "Add the page you're on, or a link on it, to Sharing on rommy.blog.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Share to rommy.blog",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["https://rommy.blog/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Share this page to rommy.blog"
    }
  }
}
