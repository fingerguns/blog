{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/docs-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking README and colophon are up to date"
          }
        ]
      }
    ]
  }
}
